{
  "nodeModulesDir": "manual",
  "workspace": [
    "./engine/packages/base",
    "./engine/packages/agent",
    "./engine/packages/composition",
    "./engine/packages/state",
    "./engine/packages/studio",
    "./engine/packages/tooling",
    "./engine/packages/ui",
    "./engine/packages/web",
    "./e2e",
    "./template",
    "./examples/bookshop",
    "./examples/cat-cafe",
    "./examples/silly-os",
    "./website"
  ],
  "fmt": {
    "exclude": [
      "e2e/fixtures/saves/engine-lab-state-3.save.json",
      "e2e/fixtures/saves/engine-lab-state-4.save.json",
      "e2e/fixtures/saves/engine-lab-state-5.save.json",
      "e2e/fixtures/saves/engine-lab-state-6.save.json",
      "examples/cat-cafe/fixtures/saves/cat-cafe-state-1.save.json"
    ],
    "useTabs": false,
    "lineWidth": 100,
    "indentWidth": 2,
    "semiColons": true,
    "singleQuote": false,
    "proseWrap": "preserve",
    "newLineKind": "lf",
    "trailingCommas": "onlyMultiLine",
    "json.trailingCommas": "jsonc",
    "sortNamedImports": "maintain",
    "sortNamedExports": "maintain"
  },
  "tasks": {
    "dev": "deno run -A npm:vite --mode e2e",
    "format": "deno fmt",
    "format:check": "deno fmt --check",
    "lint": "deno run -A npm:oxlint --type-aware --deny-warnings --react-plugin --import-plugin engine e2e examples template scripts vite.config.ts vitest.config.ts",
    "lint:styles": "deno run -A npm:stylelint \"engine/packages/**/*.css\" \"e2e/**/*.css\" \"examples/**/*.css\" \"template/**/*.css\"",
    "audit:react": "deno run -A --no-lock npm:react-doctor@^0.9.12 . --verbose --scope changed --base HEAD --include-untracked --no-score --no-supply-chain --yes --no-color --blocking none",
    "typecheck": "deno run -A npm:typescript/tsc -p tsconfig.check.json --noEmit --pretty false",
    "check:determinism": "deno run --allow-read=. scripts/determinism/check.mts",
    "test:unit": "deno run -A npm:vitest run",
    "test:coverage": "deno run -A npm:vitest run --coverage",
    "test:composition-state-bench": "deno test --no-check engine/packages/composition/bench/composition-state-workload.test.ts",
    "test": "deno task test:unit && deno task test:composition-state-bench",
    "bench:snapshot": "deno run --allow-write engine/packages/base/bench/snapshot-commit.ts",
    "bench:snapshot:memory": "deno run --v8-flags=--expose-gc --allow-write engine/packages/base/bench/snapshot-memory-growth.ts",
    "bench:composition-state": "deno run --no-check --allow-write engine/packages/composition/bench/composition-state.ts",
    "bench:composition-state:memory": "deno run --no-check --v8-flags=--expose-gc --allow-write engine/packages/composition/bench/composition-state-memory.ts",
    "bench:surfaces": "deno run -A engine/packages/ui/bench/managed-surface-lifecycle.ts",
    "bench:player:bundle": "deno run -A scripts/performance/player-build-baseline.mts",
    "bench:player": "deno task story build e2e --profile release && deno run -A npm:@playwright/test/playwright test --config engine/packages/web/playwright.performance.config.ts",
    "bench:ar5:promotion": "deno run -A scripts/performance/ar5-local-promotion.mts",
    "check:assets": "deno run -A scripts/assets/verify-runtime-assets.mts",
    "story": "deno run -A scripts/story/cli.mts",
    "author": "deno run -A scripts/story/cli.mts author",
    "check:stories": "deno run -A scripts/story/cli.mts check --all",
    "simulate:e2e": "deno run -A scripts/story/cli.mts simulate e2e",
    "test:e2e:smoke": "deno run -A npm:@playwright/test/playwright test --config engine/packages/web/playwright.engine.config.ts --project=chromium --grep @smoke",
    "test:determinism:deno": "deno run -A npm:vitest run e2e/src/test/authoritative-determinism-matrix.test.ts",
    "test:determinism:browsers": "deno run -A npm:@playwright/test/playwright test --config engine/packages/web/playwright.determinism.config.ts",
    "test:determinism": "deno task test:determinism:deno && deno task test:determinism:browsers",
    "test:e2e": "deno task test:e2e:engine && deno task test:e2e:examples",
    "test:e2e:engine": "deno run -A npm:@playwright/test/playwright test --config engine/packages/web/playwright.engine.config.ts",
    "test:e2e:examples": "deno run -A npm:@playwright/test/playwright test --config examples/e2e/playwright.examples.config.ts",
    "test:conformance:headless": "deno run -A npm:vitest run e2e",
    "test:e2e:engine:prebuilt": "deno task story build e2e && deno run -A npm:@playwright/test/playwright test --config engine/packages/web/playwright.engine-prebuilt.config.ts",
    "check": "deno task format:check && deno task lint && deno task lint:styles && deno task typecheck && deno task check:determinism && deno task test && deno task check:assets && deno task check:stories && deno task story build e2e",
    "desktop:save-server": "deno run -A scripts/desktop/save-server.mts",
    "docs:dev": "deno run -A npm:vitepress dev website",
    "docs:build": "deno run -A npm:vitepress build website",
    "docs:preview": "deno run -A npm:vitepress preview website",
    "site:build": "deno run -A scripts/build-site.mts",
    "site:deploy:cf": "deno run -A npm:wrangler@4.123.0 deploy"
  }
}
