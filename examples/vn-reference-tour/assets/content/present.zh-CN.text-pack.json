{
  "format": "sillymaker.text-content-pack",
  "version": 2,
  "packId": "text-pack.vn-reference-tour.route.present",
  "locale": "zh-CN",
  "entries": [
    {
      "textId": "text.vn-reference-tour.present.prepare.microphone",
      "text": "林澄按下话筒的选择键。磁带机停住，十三年前的标签留在透明仓盖下面。"
    },
    {
      "textId": "text.vn-reference-tour.present.prepare.hesitation",
      "text": "我以为你会选旧台呼。现在真要录，脑子里反而只剩下“清晨好”。"
    },
    {
      "textId": "text.vn-reference-tour.present.prepare.words",
      "text": "那就从清晨好开始。别替电台总结，只说此刻你确定的事。"
    },
    {
      "textId": "text.vn-reference-tour.present.prepare.ready",
      "text": "好。窗口连接以后给我一个手势，我不看稿。"
    },
    {
      "textId": "text.vn-reference-tour.present.prepare.recording",
      "text": "周遥抬起手。林澄靠近话筒，红色电平条随着她的呼吸亮了起来。"
    },
    {
      "textId": "text.vn-reference-tour.present.prepare.sent",
      "text": "“这里是山岬社区电台。清晨好。我们在最后一分钟，仍然听见彼此。”"
    },
    {
      "textId": "text.vn-reference-tour.present.roof.stairs",
      "text": "接收灯稳定后，两人沿着窄楼梯上到屋顶。东方第一束光越过了天线。"
    },
    {
      "textId": "text.vn-reference-tour.present.roof.cold",
      "text": "我刚才没有发抖吧？现在才觉得手指有点冷。"
    },
    {
      "textId": "text.vn-reference-tour.present.roof.breaker",
      "text": "声音很稳。总闸还剩十秒，你看状态灯，我来断电。"
    },
    {
      "textId": "text.vn-reference-tour.present.roof.cable",
      "text": "天线拉索在风里轻轻摆动，把最后一点震颤传到他们脚下。"
    },
    {
      "textId": "text.vn-reference-tour.present.roof.receipt",
      "text": "档案馆有回执吗？我想知道那句“彼此”真的送到了。"
    },
    {
      "textId": "text.vn-reference-tour.present.roof.confirmed",
      "text": "收到了：新台呼，完整八点一秒，标记为最后一次直播记录。"
    },
    {
      "textId": "text.vn-reference-tour.present.roof.response",
      "text": "那就好。它没有替过去说话，只留下了我们确实在这里。"
    },
    {
      "textId": "text.vn-reference-tour.present.roof.shutdown",
      "text": "周遥压下总闸。状态灯熄灭，林澄听见风穿过不再发射的天线。"
    },
    { "textId": "text.vn-reference-tour.present.ending.title", "text": "此刻入档" }
  ]
}
