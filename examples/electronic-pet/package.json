{
  "name": "@sillymaker/example-electronic-pet",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "The WIP SillyMaker Electronic Pet Reference Product.",
  "exports": {
    ".": "./src/story.ts"
  },
  "scripts": {
    "dev": "deno run -A npm:vite",
    "build": "deno task build:web",
    "build:web": "deno run -A npm:vite build",
    "build:desktop": "deno run -A ./tools/app.mts desktop .",
    "deploy:cf": "deno task build && deno run -A npm:wrangler@4.123.0 deploy",
    "preview": "deno run -A npm:vite preview",
    "clean": "rm -rf dist-web dist-desktop",
    "app": "deno run -A ./tools/app.mts",
    "check": "deno task app check . && deno run -A ./tools/check-pet-scene.mts",
    "format": "deno fmt",
    "format:check": "deno fmt --check",
    "test": "deno run -A npm:vitest run src"
  },
  "dependencies": {
    "@sillymaker/base": "workspace:*",
    "@sillymaker/ui": "workspace:*",
    "@sillymaker/web": "workspace:*",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.185.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@sillymaker/studio": "workspace:*",
    "@sillymaker/tooling": "workspace:*",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/three": "0.185.4",
    "vite": "8.2.1",
    "vitest": "4.1.10",
    "wrangler": "4.123.0"
  }
}
