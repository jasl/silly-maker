{
  "name": "@sillymaker/example-silly-os",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "SillyOS: a creator-agent product prototype built with SillyMaker.",
  "scripts": {
    "dev": "deno run -A npm:vite",
    "dev:network-broker": "deno run -A npm:vite --config vite.network-broker.config.ts",
    "dev:workspace-sandbox": "deno run -A npm:vite --config vite.workspace-sandbox.config.ts",
    "build": "deno task build:web",
    "build:web": "deno run -A npm:vite build",
    "build:network-broker": "deno run -A npm:vite build --config vite.network-broker.config.ts",
    "build:workspace-sandbox": "deno run -A npm:vite build --config vite.workspace-sandbox.config.ts",
    "check:browser-security-build": "deno run --allow-read=dist-web,src/credential ./tools/check-browser-control-plane-build.mts",
    "check:network-broker-build": "deno run --allow-read=dist-network-broker ./tools/check-browser-network-broker-build.mts",
    "check:workspace-sandbox-build": "deno run --allow-read=dist-workspace-sandbox ./tools/check-browser-workspace-sandbox-build.mts",
    "build:desktop": "deno run -A ./tools/app.mts desktop .",
    "deploy:cf": "deno task build && deno run -A npm:wrangler@4.123.0 deploy",
    "deploy:cf:network-broker": "deno task build:network-broker && deno run -A npm:wrangler@4.123.0 deploy --config wrangler.network-broker.jsonc",
    "deploy:cf:workspace-sandbox": "deno task build:workspace-sandbox && deno run -A npm:wrangler@4.123.0 deploy --config wrangler.workspace-sandbox.jsonc",
    "preview": "deno run -A npm:vite preview",
    "preview:network-broker": "deno run -A npm:vite preview --config vite.network-broker.config.ts",
    "preview:workspace-sandbox": "deno run -A npm:vite preview --config vite.workspace-sandbox.config.ts",
    "pi:rpc": "deno run -A ./tools/pi-rpc.mts",
    "qualify:browser:provider": "deno run -A --env-file=.env ./tools/qualify-browser-provider.mts",
    "qualify:browser:b1b": "deno task qualify:browser:provider b1b",
    "qualify:browser:qualified": "deno task qualify:browser:provider qualified",
    "qualify:browser:openai": "deno task qualify:browser:provider openai",
    "qualify:browser:qjs-loop": "deno task qualify:browser:provider anthropic http://127.0.0.1:4173 chromium qjs-loop",
    "clean": "rm -rf dist-web dist-network-broker dist-workspace-sandbox dist-desktop",
    "app": "deno run -A ./tools/app.mts",
    "test": "deno run -A npm:vitest run src"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.84.3",
    "@earendil-works/pi-ai": "0.84.3",
    "@earendil-works/pi-coding-agent": "0.84.3",
    "@jitl/quickjs-singlefile-browser-release-sync": "0.32.0",
    "@sillymaker/agent": "workspace:*",
    "@sillymaker/ui": "workspace:*",
    "@sillymaker/web": "workspace:*",
    "client-zip": "2.5.0",
    "just-bash": "3.4.2",
    "lucide-react": "^1.34.0",
    "quickjs-emscripten-core": "0.32.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@sillymaker/tooling": "workspace:*",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "fake-indexeddb": "6.2.5",
    "vite": "8.2.1",
    "vitest": "4.1.10",
    "wrangler": "4.123.0"
  }
}
