{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "dist",
    "jsx": "react-jsx"
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "programs/*/distribution/**/*.ts",
    "programs/*/persistence/**/*.ts",
    "programs/*/runtime/**/*.ts",
    "programs/*/runtime/**/*.tsx",
    "programs/*/runtime-profile/**/*.ts",
    "programs/*/runtime-profile/**/*.tsx",
    "programs/*/ui/**/*.ts",
    "programs/*/ui/**/*.tsx"
  ],
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.test-d.ts",
    "programs/*/test/**",
    "programs/*/notes/**"
  ],
  "references": [
    {
      "path": "../../engine/packages/web"
    }
  ]
}
