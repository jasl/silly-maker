{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sillyos://programs/translation/settings/research-v1",
  "title": "Translation Program settings",
  "type": "object",
  "default": {
    "targetLocale": "en",
    "defaultStyle": "Natural target-language prose that preserves source meaning and voice.",
    "reviewPolicy": "every_batch",
    "modelRoles": {
      "translate": null,
      "review": null,
      "ocr": null
    },
    "pdf": {
      "ocr": "off",
      "output": "bilingual_markdown"
    }
  },
  "additionalProperties": false,
  "required": [
    "targetLocale",
    "defaultStyle",
    "reviewPolicy",
    "modelRoles",
    "pdf"
  ],
  "properties": {
    "targetLocale": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?:\\S|\\S[\\s\\S]*\\S)$",
      "default": "en",
      "description": "Default target locale for new translation work."
    },
    "defaultStyle": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?:\\S|\\S[\\s\\S]*\\S)$",
      "default": "Natural target-language prose that preserves source meaning and voice.",
      "description": "Default translation style; project facts and source fidelity take priority."
    },
    "reviewPolicy": {
      "type": "string",
      "enum": [
        "every_batch",
        "flagged_batches",
        "final_only"
      ],
      "default": "every_batch"
    },
    "modelRoles": {
      "type": "object",
      "default": {
        "translate": null,
        "review": null,
        "ocr": null
      },
      "additionalProperties": false,
      "required": [
        "translate",
        "review",
        "ocr"
      ],
      "properties": {
        "translate": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^(?:\\S|\\S[\\s\\S]*\\S)$",
          "default": null,
          "x-sillyos-control": "model-selector",
          "x-sillyos-required-input": "text"
        },
        "review": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^(?:\\S|\\S[\\s\\S]*\\S)$",
          "default": null,
          "x-sillyos-control": "model-selector",
          "x-sillyos-required-input": "text"
        },
        "ocr": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^(?:\\S|\\S[\\s\\S]*\\S)$",
          "default": null,
          "x-sillyos-control": "model-selector",
          "x-sillyos-required-input": "image"
        }
      }
    },
    "pdf": {
      "type": "object",
      "default": {
        "ocr": "off",
        "output": "bilingual_markdown"
      },
      "additionalProperties": false,
      "required": [
        "ocr",
        "output"
      ],
      "properties": {
        "ocr": {
          "type": "string",
          "enum": [
            "off",
            "when_no_text"
          ],
          "default": "off",
          "description": "Research preference only; OCR execution is not delivered by this candidate."
        },
        "output": {
          "type": "string",
          "enum": [
            "translation_json",
            "translated_markdown",
            "bilingual_markdown"
          ],
          "default": "bilingual_markdown",
          "description": "Derived translation artifact; the original PDF is never rewritten."
        }
      }
    }
  }
}
