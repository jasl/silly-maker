# SillyOS raw Pi RPC development launcher only. Copy to .env and keep secrets
# local; the repository ignores .env and .env.* files.

# Configure any environment variable supported by the pinned Pi provider.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Optional path/name for an installed pinned Pi executable.
# SILLYOS_PI_COMMAND=pi
