{
  "name": "@sillymaker/story-example-cat-cafe",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Example Story: an all-ages schedule/stats/touch/contest cat-cafe sim driving the content database.",
  "exports": {
    ".": "./src/story.ts"
  },
  "scripts": {
    "dev": "deno run -A npm:vite",
    "build": "deno task build:web",
    "build:web": "deno run -A npm:vite build",
    "build:desktop": "deno run -A ./tools/story.mts desktop .",
    "preview": "deno run -A npm:vite preview",
    "story": "deno run -A ./tools/story.mts",
    "test": "deno run -A npm:vitest run examples/cat-cafe/src"
  },
  "dependencies": {
    "@sillymaker/base": "workspace:*",
    "@sillymaker/ui": "workspace:*",
    "@sillymaker/web": "workspace:*",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@sillymaker/tooling": "workspace:*",
    "@testing-library/jest-dom": "6.9.1",
    "@types/node": "24.13.3",
    "@types/react": "19.2.17"
  }
}
