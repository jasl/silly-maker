// SPDX-License-Identifier: MIT
// Standalone Cloudflare Workers deployment for this Player only (independent
// of the repository's composed docs site). Build first, then deploy from this
// directory:
//
//   deno task build          # dist-web/ — relative-base, self-contained
//   deno task deploy:cf      # needs
//                            # `deno run -A npm:wrangler@4.114.0 login` once
//
// The Player is location-independent (base "./", assets against
// document.baseURI) and saves live in the visitor's browser (IndexedDB), so
// an assets-only Worker is all it takes.
{
  "name": "silly-maker-cat-cafe",
  "compatibility_date": "2026-07-01",
  "assets": {
    "directory": "./dist-web",
    "not_found_handling": "single-page-application",
  },
}
