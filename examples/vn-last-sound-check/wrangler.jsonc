// SPDX-License-Identifier: MIT
// Standalone Cloudflare Workers deployment for the maintained flagship VN
// Reference Product. A successful deploy proves only this build's static
// Browser artifact; it does not promote Desktop production support or prove a
// live deployment until that remote operation is actually performed.
//
//   deno task deploy:cf      # builds dist-web/ and deploys it
//                            # (authenticate once:
//                            #  deno run -A npm:wrangler@4.114.0 login)
//
// The Player is location-independent (base "./", assets against
// document.baseURI) and saves live in the visitor's browser (IndexedDB), so
// an assets-only Worker is all it takes.
{
  "name": "silly-maker-vn-last-sound-check",
  "compatibility_date": "2026-07-01",
  "assets": {
    "directory": "./dist-web",
    "not_found_handling": "single-page-application",
  },
}
