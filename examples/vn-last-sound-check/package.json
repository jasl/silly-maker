{
  "name": "@sillymaker/story-example-vn-last-sound-check",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "SillyMaker's maintained flagship VN Reference Product: the complete two-route One Last Sound Check.",
  "exports": {
    ".": "./src/story.ts"
  },
  "imports": {
    "#sillymaker/scene/control-room": "./src/scenes/control-room/authoring-source.ts",
    "#sillymaker/scene/rooftop-antenna": "./src/scenes/rooftop-antenna/authoring-source.ts"
  },
  "scripts": {
    "dev": "deno run -A npm:vite",
    "dev:mods": "deno run -A npm:vite --config vite.mods.config.ts",
    "build": "deno task build:web",
    "build:web": "deno run -A npm:vite build",
    "build:web:mods": "deno run -A npm:vite build --config vite.mods.config.ts",
    "build:desktop": "deno run -A ./tools/app.mts desktop .",
    "deploy:cf": "deno task build && deno run -A npm:wrangler@4.123.0 deploy",
    "preview": "deno run -A npm:vite preview",
    "clean": "rm -rf dist-web dist-web-mods dist-desktop",
    "app": "deno run -A ./tools/app.mts",
    "format": "deno fmt",
    "format:check": "deno fmt --check",
    "test": "deno run -A npm:vitest run src"
  },
  "dependencies": {
    "@sillymaker/base": "workspace:*",
    "@sillymaker/composition": "workspace:*",
    "@sillymaker/ui": "workspace:*",
    "@sillymaker/vn": "workspace:*",
    "@sillymaker/web": "workspace:*",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@sillymaker/studio": "workspace:*",
    "@sillymaker/tooling": "workspace:*",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "vite": "8.2.1",
    "vitest": "4.1.10",
    "wrangler": "4.123.0"
  }
}
